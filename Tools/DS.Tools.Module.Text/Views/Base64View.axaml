<UserControl
    x:Class="DS.Tools.Module.Text.Views.Base64View"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="viewModels:Base64ViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--  共享样式（卡片/标题/输入框/结果框/按钮/错误提示）  -->
        <StyleInclude Source="avares://DS.Tools.UI.Shared/Styles/ToolStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel
            Margin="32"
            Spacing="0">
            <!--  标题区域  -->
            <StackPanel Margin="0,0,0,32">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="Base64 编解码" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="文本与 Base64 之间的相互转换" />
            </StackPanel>

            <!--  编码区域  -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="🔤 文本转 Base64" />

                    <TextBox
                        AcceptsReturn="True"
                        Classes="formInput"
                        MinHeight="100"
                        PlaceholderText="输入要编码的文本..."
                        Text="{Binding InputText, Mode=TwoWay}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Classes="action-button"
                            Command="{Binding EncodeCommand}"
                            Content="编码" />
                        <Button
                            Classes="secondary-button"
                            Command="{Binding ClearCommand}"
                            Content="清空" />
                    </StackPanel>

                    <!--  错误提示  -->
                    <TextBlock
                        Classes="errorText"
                        IsVisible="{Binding HasErrors}"
                        Text="{Binding ErrorMessage}" />

                    <!--  编码结果  -->
                    <Border
                        Classes="resultBox"
                        IsVisible="{Binding EncodedResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <DockPanel>
                            <Button
                                Classes="compact-button"
                                Command="{Binding CopyEncodedCommand}"
                                Content="复制"
                                DockPanel.Dock="Right" />

                            <TextBlock
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource AccentSuccessBrush}"
                                Text="{Binding EncodedResult}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  解码区域  -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="🔓 Base64 转文本" />

                    <TextBox
                        AcceptsReturn="True"
                        Classes="formInput"
                        MinHeight="100"
                        PlaceholderText="输入 Base64 字符串..."
                        Text="{Binding InputText, Mode=TwoWay}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Classes="action-button"
                            Command="{Binding DecodeCommand}"
                            Content="解码" />
                        <Button
                            Classes="secondary-button"
                            Command="{Binding ClearCommand}"
                            Content="清空" />
                    </StackPanel>

                    <!--  错误提示  -->
                    <TextBlock
                        Classes="errorText"
                        IsVisible="{Binding HasErrors}"
                        Text="{Binding ErrorMessage}" />

                    <!--  解码结果  -->
                    <Border
                        Classes="resultBox"
                        IsVisible="{Binding DecodedResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <DockPanel>
                            <Button
                                Classes="compact-button"
                                Command="{Binding CopyDecodedCommand}"
                                Content="复制"
                                DockPanel.Dock="Right" />

                            <TextBlock
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding DecodedResult}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
