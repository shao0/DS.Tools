<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         工具视图共享样式（UI.Shared）：
         全部工具模块的视图经 StyleInclude 引用本文件，消除各视图内联
         样式重复。class 命名统一 kebab-case（Avalonia class 区分大小写）。
         颜色一律 DynamicResource 引用 App 主题色板。
    ============================================================ -->

    <!-- 卡片容器 -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- 卡片标题 -->
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- ============================================================
         统一控件高度体系（两档）：
         - 标准 36：TextBox / ComboBox / CalendarDatePicker（formInput）
                    与常规按钮（action-button / secondary-button）同高，
                    同一工具行混排完全对齐
         - 紧凑 28：compact-button（结果框/列表项内嵌小操作）
    ============================================================ -->

    <!-- 表单输入框（单行文本） -->
    <Style Selector="TextBox.formInput">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox.formInput:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- 下拉框：与 TextBox.formInput 同高同观感（工具行混排对齐） -->
    <Style Selector="ComboBox.formInput">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="ComboBox.formInput:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- 日期选择器：与 TextBox.formInput 同高同观感（工具行混排对齐） -->
    <Style Selector="CalendarDatePicker.formInput">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker.formInput:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- 无边框输入框（置于带边框的容器内，避免双重边框） -->
    <Style Selector="TextBox.borderless">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 结果框 -->
    <Style Selector="Border.resultBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- 错误提示文本 -->
    <Style Selector="TextBlock.errorText">
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 工具栏/卡片主操作按钮（标准高度 36，与 formInput 输入控件同高） -->
    <Style Selector="Button.action-button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryFgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!--  hover/按下态作用于模板部件 ContentPresenter，过渡动画挂同一层级才生效  -->
    <Style Selector="Button.action-button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.action-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>

    <Style Selector="Button.action-button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 次要操作按钮（标准高度 36，与 formInput 输入控件同高） -->
    <Style Selector="Button.secondary-button">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style Selector="Button.secondary-button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.secondary-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
    </Style>

    <Style Selector="Button.secondary-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.secondary-button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- 紧凑小按钮（结果框/列表项内嵌操作；高度 28，随内容自适应宽度） -->
    <Style Selector="Button.compact-button">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style Selector="Button.compact-button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.compact-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
    </Style>

    <Style Selector="Button.compact-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- 滚动条 -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
    </Style>

</Styles>
