<UserControl
    x:Class="DS.Tools.Module.Text.Views.TimestampConverterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:TimestampConverterViewModel"
    mc:Ignorable="d">


    <UserControl.Styles>
        <!--  共享样式（卡片/标题/输入框/结果框/按钮）  -->
        <StyleInclude Source="avares://DS.Tools.UI.Shared/Styles/ToolStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel
            Margin="32"
            Spacing="0">
            <StackPanel Margin="0,0,0,32">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="时间戳转换" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="时间戳与日期时间相互转换" />
            </StackPanel>

            <!--  时间戳转日期  -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="⏱️ 时间戳转日期" />
                    <TextBox
                        Classes="formInput"
                        PlaceholderText="输入时间戳（秒或毫秒）..."
                        Text="{Binding TimestampInput, Mode=TwoWay}" />
                    <Button
                        Margin="0,12,0,0"
                        Classes="btn primary"
                        Command="{Binding TimestampToDateCommand}"
                        Content="转换" />
                    <Border
                        Classes="resultBox"
                        IsVisible="{Binding ConvertedDateTime, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock>
                                <Run
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="本地时间: " />
                                <Run
                                    Foreground="{DynamicResource AccentSuccessBrush}"
                                    Text="{Binding ConvertedDateTime}" />
                            </TextBlock>
                            <TextBlock>
                                <Run
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="UTC时间: " />
                                <Run
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding UtcDateTime}" />
                            </TextBlock>
                            <TextBlock>
                                <Run
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="ISO格式: " />
                                <Run
                                    FontSize="12"
                                    Foreground="{DynamicResource AccentWarningBrush}"
                                    Text="{Binding IsoFormat}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button
                        Margin="0,12,0,0"
                        Classes="btn secondary"
                        Command="{Binding ClearTimestampCommand}"
                        Content="清空" />
                </StackPanel>
            </Border>

            <!--  日期转时间戳  -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="📅 日期转时间戳" />
                    <TextBox
                        Classes="formInput"
                        PlaceholderText="输入日期时间（yyyy-MM-dd HH:mm:ss）..."
                        Text="{Binding DateInput, Mode=TwoWay}" />
                    <Button
                        Margin="0,12,0,0"
                        Classes="btn primary"
                        Command="{Binding DateToTimestampCommand}"
                        Content="转换" />
                    <Border
                        Classes="resultBox"
                        IsVisible="{Binding SecondsTimestamp, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock>
                                <Run
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="秒级时间戳: " />
                                <Run
                                    Foreground="{DynamicResource AccentSuccessBrush}"
                                    Text="{Binding SecondsTimestamp}" />
                            </TextBlock>
                            <TextBlock>
                                <Run
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="毫秒级时间戳: " />
                                <Run
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding MillisecondsTimestamp}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button
                        Margin="0,12,0,0"
                        Classes="btn secondary"
                        Command="{Binding ClearDateCommand}"
                        Content="清空" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
