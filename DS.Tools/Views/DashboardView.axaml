<UserControl
    x:Class="DS.Tools.Views.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.ViewModels"
    d:DesignHeight="650"
    d:DesignWidth="900"
    x:CompileBindings="True"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <!--  主页样式（统计卡片/功能磁贴）独立于 DashboardViewStyles.axaml，经 StyleInclude 引用  -->
    <UserControl.Styles>
        <StyleInclude Source="avares://DS.Tools/Views/DashboardViewStyles.axaml" />
    </UserControl.Styles>

    <!--  主页内容  -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="32"
            Spacing="24">
            <!--  标题  -->
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="主页" />

            <!--  统计卡片（2x2，外观统一走 statCard 类样式）  -->
            <Grid ColumnDefinitions="*,*">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,16"
                    Classes="statCard">
                    <StackPanel>
                        <TextBlock
                            Classes="statIcon"
                            Text="⏰" />
                        <TextBlock
                            Classes="statValue"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding CurrentTime}" />
                        <TextBlock
                            Classes="statLabel"
                            Text="当前时间" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,16"
                    Classes="statCard">
                    <StackPanel>
                        <TextBlock
                            Classes="statIcon"
                            Text="📅" />
                        <TextBlock
                            Classes="statValue"
                            Foreground="{DynamicResource AccentSuccessBrush}"
                            Text="{Binding CurrentDate}" />
                        <TextBlock
                            Classes="statLabel"
                            Text="今日日期" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Classes="statCard">
                    <StackPanel>
                        <TextBlock
                            Classes="statIcon"
                            Text="🕐" />
                        <TextBlock
                            Classes="statValue"
                            Foreground="{DynamicResource AccentWarningBrush}"
                            Text="{Binding Timestamp}" />
                        <TextBlock
                            Classes="statLabel"
                            Text="当前时间戳（秒）" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Classes="statCard">
                    <StackPanel>
                        <TextBlock
                            Classes="statIcon"
                            Text="🧩" />
                        <TextBlock
                            Classes="statValue"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding ToolCount}" />
                        <TextBlock
                            Classes="statLabel"
                            Text="功能总数" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  功能分组：按模块展示全部工具  -->
            <ItemsControl ItemsSource="{Binding ModuleGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardModuleGroup">
                        <Border
                            Margin="0,0,0,8"
                            Padding="24"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="16">
                                <!--  模块标题  -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding ModuleIcon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding ModuleName}" />
                                </StackPanel>

                                <!--  工具磁贴（自动换行）  -->
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DashboardToolItem">
                                            <!--  ReSharper disable once Xaml.PossibleNullReferenceException  -->
                                            <Button
                                                MinWidth="140"
                                                Margin="0,0,12,12"
                                                Classes="toolTile"
                                                Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).NavigateToToolCommand}"
                                                CommandParameter="{Binding NavigationId}">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Text="{Binding Icon}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
