<Window
    x:Class="DS.Tools.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:DS.Tools.Module.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:module="using:DS.Tools.Module.Base.Interfaces"
    xmlns:vm="using:DS.Tools.ViewModels"
    Title="DS.Tools - Developer Utilities"
    Width="1200"
    Height="800"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource BackgroundBrush}"
    Icon="avares://DS.Tools.UI.Shared/Assets/app-icon.ico"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    mc:Ignorable="d">

    <!--
        ViewModel→View 映射：由 IToolCatalog 统一目录管理（AOT 兼容，零反射）——
        注册点收敛为各模块 Register（ToolRegistration.AddSubTool 一行完成子工具 + View 映射）
        + 组合根主页注册（AddViewMapping）；
        MainWindow 构造时挂载 ViewRegistryDataTemplate（见 MainWindow.axaml.cs），
        ContentControl 按目录渲染。
    -->

    <!--  窗口级样式（侧边栏/菜单/窗口控制按钮）独立于 MainWindowStyles.axaml，经 StyleInclude 引用  -->
    <Window.Styles>
        <StyleInclude Source="avares://DS.Tools/Views/MainWindowStyles.axaml" />
    </Window.Styles>

    <DockPanel>
        <!--  自定义标题栏（无边框窗口：拖拽移动 / 双击最大化；按钮区域排除拖拽，见 TitleBar_OnPointerPressed）  -->
        <Border
            x:Name="TitleBar"
            Height="44"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            PointerPressed="TitleBar_OnPointerPressed">
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!--  窗口标题和图标（点击返回主页）  -->
                <Button
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateToHomeCommand}"
                    Cursor="Hand"
                    ToolTip.Tip="返回主页">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🧰" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="DS.Tools" />
                    </StackPanel>
                </Button>

                <!--  窗口控制按钮和主题切换  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="Transparent">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4">
                        <!--  侧边栏切换按钮  -->
                        <Button
                            Classes="themeToggle"
                            Command="{Binding TogglePaneCommand}"
                            ToolTip.Tip="切换侧边栏">
                            <TextBlock
                                FontSize="16"
                                Text="☰" />
                        </Button>

                        <!--  主题切换按钮  -->
                        <Button
                            Classes="themeToggle"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="切换主题">
                            <TextBlock
                                FontSize="16"
                                Text="{Binding CurrentThemeIcon}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!--  窗口控制按钮：最小化 / 最大化 / 关闭  -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <Button
                        Classes="windowButton"
                        Click="MinimizeButton_OnClick"
                        ToolTip.Tip="最小化">
                        <!-- Stretch 不可用：最小化图标 bounds 零高度，Uniform 拉伸会被裁切消失；数据坐标直渲（默认 None） -->
                        <Path
                            Width="16"
                            Height="16"
                            Fill="Transparent"
                            Stroke="{DynamicResource TextSecondaryBrush}"
                            StrokeThickness="1.2"
                            Data="M3.5 11.5 H12.5" />
                    </Button>

                    <Button
                        Classes="windowButton"
                        Click="MaximizeButton_OnClick"
                        ToolTip.Tip="最大化/还原">
                        <Grid
                            Width="16"
                            Height="16">
                            <Path
                                x:Name="MaximizeIcon"
                                Fill="Transparent"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeThickness="1.2"
                                Data="M3.5 3.5 H12.5 V12.5 H3.5 Z" />
                            <Path
                                x:Name="RestoreIcon"
                                IsVisible="False"
                                Fill="Transparent"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeThickness="1.2"
                                Data="M5.5 3.5 H12.5 V10.5 H3.5 V12.5 H10.5 V5.5 H5.5 Z" />
                        </Grid>
                    </Button>

                    <Button
                        Classes="windowButton close"
                        Click="CloseButton_OnClick"
                        ToolTip.Tip="关闭">
                        <Path
                            Width="16"
                            Height="16"
                            Fill="Transparent"
                            Stroke="{DynamicResource TextSecondaryBrush}"
                            StrokeThickness="1.2"
                            Data="M4.5 4.5 L11.5 11.5 M11.5 4.5 L4.5 11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  主内容区：SplitView 支持侧边栏  -->
        <SplitView
            Background="{DynamicResource BackgroundBrush}"
            DisplayMode="Inline"
            IsPaneOpen="{Binding IsPaneOpen}"
            OpenPaneLength="280">
            <SplitView.Pane>
                <!--  侧边栏：二级菜单结构  -->
                <Border Classes="sidebar">
                    <DockPanel>
                        <!--  版本信息最先声明：固定停靠底部（避免被 LastChildFill 拉伸）  -->
                        <Border
                            Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="DS.Tools v1.0" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="本地运行" />
                            </StackPanel>
                        </Border>

                        <!--  Logo 区域（固定顶部）  -->
                        <Border
                            Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Text="⚙️" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="工具箱" />
                            </StackPanel>
                        </Border>

                        <!--  工具模块列表（二级菜单 + Expander原生展开/收起，填满剩余空间）  -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="module:IToolModule">
                                        <!--  模块容器  -->
                                        <DockPanel Margin="0,4">



                                            <!--  有子工具的模块：使用 Expander 原生展开功能  -->
                                            <Expander
                                                Margin="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                BorderThickness="0"
                                                DockPanel.Dock="Top"
                                                IsVisible="{Binding HasSubTools}">
                                                <Expander.Header>
                                                    <!--  一级菜单：模块标题（moduleItem 样式 + 内联内边距）  -->
                                                    <Border Classes="moduleItem">
                                                        <StackPanel
                                                            HorizontalAlignment="Left"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="18"
                                                                Text="{Binding Icon}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Classes="moduleItemTitle"
                                                                Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Expander.Header>

                                                <!--  二级菜单：子工具列表  -->
                                                <ItemsControl ItemsSource="{Binding SubTools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="base:SubToolInfo">
                                                            <!--  ReSharper disable once Xaml.PossibleNullReferenceException  -->
                                                            <Button
                                                                Classes="subToolItem"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSubToolCommand}"
                                                                CommandParameter="{Binding}">
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14"
                                                                        Text="{Binding Icon}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </SplitView.Pane>

            <!--  内容区：当前工具的视图 - 经 ViewRegistryDataTemplate 按注册表映射渲染  -->
            <Border Background="{DynamicResource BackgroundBrush}">
                <ContentControl Content="{Binding ActiveToolViewModel}" />
            </Border>
        </SplitView>
    </DockPanel>
</Window>