{
  "Theme": {
    "DefaultTheme": "System",
    "FollowSystemTheme": true
  },
  "Logging": {
    "DefaultLevel": "Information",
    "WriteToFile": true,
    "LogFilePath": "logs/app.log",
    "MaxFileSizeMB": 10,
    "RetainedFileCount": 5
  },
  "Localization": {
    "DefaultCulture": "zh-CN",
    "SupportedCultures": [ "zh-CN", "en-US" ]
  },
  "Tools": {
    "DefaultToolId": "text-tools",
    "EnabledTools": [
      "dashboard",
      "json-formatter",
      "base64-converter",
      "color-converter",
      "timestamp-converter",
      "password-generator",
      "text-hasher"
    ]
  }
}
