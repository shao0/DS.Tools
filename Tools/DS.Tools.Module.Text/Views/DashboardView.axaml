<UserControl
    x:Class="DS.Tools.Module.Text.Views.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <!--  仪表盘内容  -->
    <StackPanel Margin="32">
        <!--  标题  -->
        <TextBlock
            Margin="0,0,0,32"
            FontSize="28"
            FontWeight="Bold"
            Text="仪表盘" />

        <!--  统计卡片网格  -->
        <Grid ColumnDefinitions="*,3*">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  当前时间卡片  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,16"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Text="⏰" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding CurrentTime}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="当前时间" />
                </StackPanel>
            </Border>

            <!--  当前日期卡片  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,8,16"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Text="📅" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentSuccessBrush}"
                        Text="{Binding CurrentDate}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="今日日期" />
                </StackPanel>
            </Border>

            <!--  时间戳卡片  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Text="🕐" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentWarningBrush}"
                        Text="{Binding Timestamp}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="当前时间戳（秒）" />
                </StackPanel>
            </Border>

            <!--  空白占位  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,8,0"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Text="🛠️" />
            </Border>
        </Grid>

        <!--  快速操作  -->
        <Border
            Margin="0,24,0,0"
            Padding="24"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="⚡ 快速操作" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Padding="12,8"
                        Background="{DynamicResource PrimaryBrush}"
                        Command="{Binding NavigateToJsonCommand}"
                        Content="JSON 格式化"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryFgBrush}" />

                    <Button
                        Padding="12,8"
                        Background="{DynamicResource SecondaryBrush}"
                        Command="{Binding NavigateToBase64Command}"
                        Content="Base64 编码"
                        CornerRadius="8"
                        Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button
                        Padding="12,8"
                        Background="{DynamicResource SecondaryBrush}"
                        Command="{Binding NavigateToColorCommand}"
                        Content="颜色转换"
                        CornerRadius="8"
                        Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button
                        Padding="12,8"
                        Background="{DynamicResource SecondaryBrush}"
                        Command="{Binding NavigateToPasswordCommand}"
                        Content="生成密码"
                        CornerRadius="8"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
