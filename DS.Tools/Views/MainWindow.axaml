<Window
    x:Class="DS.Tools.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:DS.Tools.Module.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gitviews="using:DS.Tools.Module.Git.Views"
    xmlns:gitvm="using:DS.Tools.Module.Git.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:module="using:DS.Tools.Module.Base.Interfaces"
    xmlns:textviews="using:DS.Tools.Module.Text.Views"
    xmlns:textvm="using:DS.Tools.Module.Text.ViewModels"
    xmlns:views="using:DS.Tools.Views"
    xmlns:vm="using:DS.Tools.ViewModels"
    x:Name="RootWindow"
    Title="DS.Tools - Developer Utilities"
    Width="1200"
    Height="800"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource BackgroundBrush}"
    Icon="avares://DS.Tools.UI.Shared/Assets/app-icon.ico"
    mc:Ignorable="d">

    <!--
        ViewModel→View 映射：编译期 DataTemplate（NativeAOT 兼容，零反射）。
        每个工具 ViewModel 通过 x:DataType 显式声明，由 Avalonia XAML 编译器
        生成强类型绑定与直接 new View() 的实例化代码。
    -->
    <Window.DataTemplates>
        <DataTemplate x:DataType="vm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:JsonFormatterViewModel">
            <textviews:JsonFormatterView />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:Base64ViewModel">
            <textviews:Base64View />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:ColorConverterViewModel">
            <textviews:ColorConverterView />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:PasswordGeneratorViewModel">
            <textviews:PasswordGeneratorView />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:TextHasherViewModel">
            <textviews:TextHasherView />
        </DataTemplate>
        <DataTemplate x:DataType="textvm:TimestampConverterViewModel">
            <textviews:TimestampConverterView />
        </DataTemplate>
        <DataTemplate x:DataType="gitvm:GitLogViewModel">
            <gitviews:GitLogView />
        </DataTemplate>
    </Window.DataTemplates>

    <!--  窗口 chrome 自定义  -->
    <Window.Styles>
        <Style Selector="Window[ExtendClientAreaToDecorationsHint=True]">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  侧边栏样式  -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <!--  一级菜单项样式：Border 容器（Expander.Header 与无子工具分支均命中）  -->
        <Style Selector="Border.moduleItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.moduleItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>

        <!--  一级菜单标题文字样式  -->
        <Style Selector="TextBlock.moduleItemTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!--  二级菜单项样式  -->
        <Style Selector="Button.subToolItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="28,6" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.subToolItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!--  选中状态样式  -->
        <Style Selector="Border.moduleItem.active">
            <Setter Property="Background" Value="{DynamicResource ActiveBackgroundBrush}" />
        </Style>

        <Style Selector="Button.subToolItem.active">
            <Setter Property="Background" Value="{DynamicResource ActiveBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!--  Expander 样式  -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Expander ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="Expander ToggleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!--  主题切换按钮样式  -->
        <Style Selector="Button.themeToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="Button.themeToggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!--  自定义标题栏  -->
        <Border
            Height="40"
            Background="{DynamicResource SurfaceBrush}"
            DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">

                <!--  窗口标题和图标（点击返回主页）  -->
                <Button
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding NavigateToHomeCommand}"
                    ToolTip.Tip="返回主页">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🧰" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="DS.Tools" />
                    </StackPanel>
                </Button>

                <!--  窗口控制按钮和主题切换  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="Transparent">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4">
                        <!--  侧边栏切换按钮  -->
                        <Button
                            Classes="themeToggle"
                            Command="{Binding TogglePaneCommand}"
                            ToolTip.Tip="切换侧边栏">
                            <TextBlock
                                FontSize="16"
                                Text="☰" />
                        </Button>

                        <!--  主题切换按钮  -->
                        <Button
                            Classes="themeToggle"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="切换主题">
                            <TextBlock
                                FontSize="16"
                                Text="{Binding CurrentThemeIcon}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  主内容区：SplitView 支持侧边栏  -->
        <SplitView
            Background="{DynamicResource BackgroundBrush}"
            DisplayMode="Inline"
            IsPaneOpen="{Binding IsPaneOpen}"
            OpenPaneLength="280">
            <SplitView.Pane>
                <!--  侧边栏：二级菜单结构  -->
                <Border Classes="sidebar">
                    <DockPanel>
                        <!--  版本信息最先声明：固定停靠底部（避免被 LastChildFill 拉伸）  -->
                        <Border
                            Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="DS.Tools v1.0" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="本地运行" />
                            </StackPanel>
                        </Border>

                        <!--  Logo 区域（固定顶部）  -->
                        <Border
                            Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Text="⚙️" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="工具箱" />
                            </StackPanel>
                        </Border>

                        <!--  工具模块列表（二级菜单 + Expander原生展开/收起，填满剩余空间）  -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="module:IToolModule">
                                        <!--  模块容器  -->
                                        <DockPanel Margin="0,4">



                                            <!--  有子工具的模块：使用 Expander 原生展开功能  -->
                                            <Expander
                                                Margin="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                BorderThickness="0"
                                                DockPanel.Dock="Top"
                                                IsVisible="{Binding HasSubTools}">
                                                <Expander.Header>
                                                    <!--  一级菜单：模块标题（moduleItem 样式 + 内联内边距）  -->
                                                    <Border Classes="moduleItem">
                                                        <StackPanel
                                                            HorizontalAlignment="Left"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="18"
                                                                Text="{Binding Icon}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Classes="moduleItemTitle"
                                                                Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Expander.Header>

                                                <!--  二级菜单：子工具列表  -->
                                                <ItemsControl ItemsSource="{Binding SubTools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="base:SubToolInfo">
                                                            <Button
                                                                Classes="subToolItem"
                                                                Command="{Binding ElementName=RootWindow, Path=DataContext.SelectSubToolCommand}"
                                                                CommandParameter="{Binding}">
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14"
                                                                        Text="{Binding Icon}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </SplitView.Pane>

            <!--  内容区：当前工具的视图 - 由窗口级 DataTemplate 按编译期映射渲染  -->
            <Border Background="{DynamicResource BackgroundBrush}">
                <ContentControl Content="{Binding ActiveToolViewModel}" />
            </Border>
        </SplitView>
    </DockPanel>
</Window>