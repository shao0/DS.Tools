<UserControl
    x:Class="DS.Tools.Module.Text.Views.JsonFormatterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:JsonFormatterViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <StyleInclude Source="avares://DS.Tools.Module.Text/Styles/JsonFormatterStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--  标题区域  -->
        <Border
            Grid.Row="0"
            Padding="24,16"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="12,12,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Text="📝" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="JSON 格式化" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="格式化、压缩和验证 JSON 数据" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  操作按钮区域  -->
        <Border
            Grid.Row="1"
            Padding="24,16,24,0"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    MinWidth="120"
                    Padding="16,10"
                    Classes="ActionButton"
                    Command="{Binding FormatCommand}"
                    Content="✨ 格式化" />

                <Button
                    MinWidth="120"
                    Padding="16,10"
                    Classes="ActionButton"
                    Command="{Binding CompressCommand}"
                    Content="🗜️ 压缩" />

                <Button
                    MinWidth="120"
                    Padding="16,10"
                    Classes="ActionButton"
                    Command="{Binding ValidateCommand}"
                    Content="✓ 验证" />

                <Button
                    MinWidth="100"
                    Padding="16,10"
                    Classes="SecondaryButton"
                    Command="{Binding ClearCommand}"
                    Content="🗑️ 清空" />

                <Button
                    MinWidth="120"
                    Padding="16,10"
                    Classes="SecondaryButton"
                    Command="{Binding CopyOutputCommand}"
                    Content="📋 复制结果" />
            </StackPanel>
        </Border>

        <!--  主内容区域（输入和输出）  -->
        <Grid
            Grid.Row="2"
            Margin="24,16"
            ColumnDefinitions="*,8,*">
            <!--  输入区域  -->
            <Border
                Grid.Column="0"
                Padding="16"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <!--  输入标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="📥 输入 JSON" />

                    <!--  输入文本框  -->
                    <Border
                        Grid.Row="1"
                        Padding="12"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBox
                            MinHeight="200"
                            MaxHeight="400"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            CaretBrush="{DynamicResource TextPrimaryBrush}"
                            FontFamily="Consolas,Courier New,monospace"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            PlaceholderText="在此粘贴或输入 JSON 文本..."
                            SelectionBrush="{DynamicResource PrimaryBrush}"
                            SelectionForegroundBrush="{DynamicResource PrimaryFgBrush}"
                            Text="{Binding InputJson, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!--  分隔线  -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource SecondaryBrush}"
                BorderThickness="1,0,0,0"
                Opacity="0.3" />

            <!--  输出区域  -->
            <Border
                Grid.Column="2"
                Padding="16"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <!--  输出标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="📤 输出结果" />

                    <!--  输出内容（错误信息或格式化结果）  -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!--  错误显示  -->
                            <Border
                                Padding="16"
                                Background="{DynamicResource ErrorBackgroundBrush}"
                                BorderBrush="{DynamicResource ErrorBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsVisible="{Binding HasErrors}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ErrorTextBrush}"
                                        Text="❌ 错误" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource ErrorTextBrush}"
                                        Text="{Binding ErrorMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  成功状态消息  -->
                            <Border
                                Padding="12,16"
                                Background="{DynamicResource SuccessBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsVisible="{Binding HasOutput}">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource SuccessTextBrush}"
                                    Text="{Binding StatusMessage}" />
                            </Border>

                            <!--  格式化结果  -->
                            <Border
                                MinHeight="150"
                                MaxHeight="350"
                                Padding="12"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsVisible="{Binding HasOutput}">
                                <TextBox
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CaretBrush="{DynamicResource TextPrimaryBrush}"
                                    FontFamily="Consolas,Courier New,monospace"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    IsReadOnly="True"
                                    SelectionBrush="{DynamicResource PrimaryBrush}"
                                    SelectionForegroundBrush="{DynamicResource PrimaryFgBrush}"
                                    Text="{Binding OutputJson, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  状态栏  -->
        <Border
            Grid.Row="3"
            Padding="24,12"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,12,12">
            <Grid ColumnDefinitions="*,Auto">
                <!--  处理状态  -->
                <StackPanel
                    Grid.Column="0"
                    IsVisible="{Binding IsProcessing}"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Grid
                        Width="16"
                        Height="16">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="Transparent"
                            Stroke="{DynamicResource PrimaryBrush}"
                            StrokeThickness="2" />
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="Transparent"
                            Stroke="{DynamicResource PrimaryBrush}"
                            StrokeDashArray="4,2"
                            StrokeThickness="2">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation
                                            IterationCount="INFINITE"
                                            Duration="0:0:1">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="RenderTransform">
                                                    <RotateTransform Angle="0" />
                                                </Setter>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="RenderTransform">
                                                    <RotateTransform Angle="360" />
                                                </Setter>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="处理中..." />
                </StackPanel>

                <!--  统计信息  -->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="支持 JSON 格式化、压缩和验证" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
