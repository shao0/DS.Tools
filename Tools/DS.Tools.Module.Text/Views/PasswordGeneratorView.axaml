<UserControl
    x:Class="DS.Tools.Module.Text.Views.PasswordGeneratorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:PasswordGeneratorViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style Selector="Border.passwordDisplay">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel
            Margin="32"
            Spacing="0">
            <StackPanel Margin="0,0,0,32">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#F1F5F9"
                    Text="密码生成器" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="#94A3B8"
                    Text="生成安全强密码" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="🔑 密码生成" />

                    <!--  密码显示  -->
                    <Border
                        Margin="0,0,0,20"
                        Classes="passwordDisplay">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Consolas,monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#10B981"
                            LetterSpacing="2"
                            Text="{Binding GeneratedPassword}" />
                    </Border>

                    <!--  密码长度  -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Text="密码长度: 16" />
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="64"
                            Minimum="4"
                            TickFrequency="4"
                            Value="{Binding PasswordLength, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  选项  -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Text="选项" />
                        <StackPanel Spacing="8">
                            <CheckBox
                                Content="大写字母 (A-Z)"
                                IsChecked="{Binding UseUppercase}" />
                            <CheckBox
                                Content="小写字母 (a-z)"
                                IsChecked="{Binding UseLowercase}" />
                            <CheckBox
                                Content="数字 (0-9)"
                                IsChecked="{Binding UseNumbers}" />
                            <CheckBox
                                Content="特殊符号 (!@#$)"
                                IsChecked="{Binding UseSymbols}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  按钮组  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Padding="16,20"
                            Background="#3B82F6"
                            BorderThickness="0"
                            Command="{Binding GenerateCommand}"
                            Content="生成密码"
                            CornerRadius="8"
                            Cursor="Hand"
                            FontWeight="Medium"
                            Foreground="White" />
                        <Button
                            Padding="16,20"
                            Background="#334155"
                            BorderThickness="0"
                            Command="{Binding CopyCommand}"
                            Content="复制密码"
                            CornerRadius="8"
                            Cursor="Hand"
                            FontWeight="Medium"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
