<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DS.Tools.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <!-- Fluent Theme -->
        <FluentTheme />

        <!-- Global Font Family -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <!-- Custom Button Styles -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryFgBrush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Card Panel Styles -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <!-- TextBox Styles -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- ============================================================
             语义化色板：Light / Dark 双主题。
             所有控件样式与视图一律引用此处资源键（DynamicResource），
             主题切换（ThemeService）即全局生效。
        ============================================================ -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
            <!-- 深色主题（默认） -->
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />
                <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
                <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
                <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
                <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
                <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
                <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2563EB" />
                <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1D4ED8" />
                <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="SecondaryBrush" Color="#334155" />
                <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#475569" />
                <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E293B" />
                <SolidColorBrush x:Key="AccentSuccessBrush" Color="#10B981" />
                <SolidColorBrush x:Key="AccentWarningBrush" Color="#F59E0B" />
                <SolidColorBrush x:Key="ActiveBackgroundBrush" Color="#263B82F6" />
                <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#450A0A" />
                <SolidColorBrush x:Key="ErrorBorderBrush" Color="#DC2626" />
                <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5" />
                <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#064E3B" />
                <SolidColorBrush x:Key="SuccessTextBrush" Color="#6EE7B7" />
            </ResourceDictionary>

            <!-- 浅色主题 -->
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC" />
                <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
                <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
                <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
                <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
                <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF" />
                <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="SecondaryBrush" Color="#E2E8F0" />
                <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#CBD5E1" />
                <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="AccentSuccessBrush" Color="#059669" />
                <SolidColorBrush x:Key="AccentWarningBrush" Color="#D97706" />
                <SolidColorBrush x:Key="ActiveBackgroundBrush" Color="#1A2563EB" />
                <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2" />
                <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FCA5A5" />
                <SolidColorBrush x:Key="ErrorTextBrush" Color="#DC2626" />
                <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#D1FAE5" />
                <SolidColorBrush x:Key="SuccessTextBrush" Color="#059669" />
            </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Icon Resources -->
            <x:String x:Key="IconDashboard">📊</x:String>
            <x:String x:Key="IconJson">📝</x:String>
            <x:String x:Key="IconBase64">🔐</x:String>
            <x:String x:Key="IconColor">🎨</x:String>
            <x:String x:Key="IconTimestamp">⏰</x:String>
            <x:String x:Key="IconPassword">🔑</x:String>
            <x:String x:Key="IconHash">#️⃣</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
