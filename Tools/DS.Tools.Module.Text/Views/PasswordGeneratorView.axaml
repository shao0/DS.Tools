<UserControl
    x:Class="DS.Tools.Module.Text.Views.PasswordGeneratorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS.Tools.Module.Text.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:PasswordGeneratorViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--  共享样式（卡片/标题）  -->
        <StyleInclude Source="avares://DS.Tools.UI.Shared/Styles/ToolStyles.axaml" />

        <!--  密码显示框（本视图专属）  -->
        <Style Selector="Border.passwordDisplay">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel
            Margin="32"
            Spacing="0">
            <StackPanel Margin="0,0,0,32">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="密码生成器" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="生成安全强密码" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock
                        Classes="cardTitle"
                        Text="🔑 密码生成" />

                    <!--  密码显示  -->
                    <Border
                        Margin="0,0,0,20"
                        Classes="passwordDisplay">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Consolas,monospace"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentSuccessBrush}"
                            LetterSpacing="2"
                            Text="{Binding GeneratedPassword}" />
                    </Border>

                    <!--  密码长度  -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding PasswordLengthDisplay, StringFormat='密码长度: {0}'}" />
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="64"
                            Minimum="4"
                            TickFrequency="4"
                            Value="{Binding PasswordLength, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  选项  -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="选项" />
                        <StackPanel Spacing="8">
                            <CheckBox
                                Content="大写字母 (A-Z)"
                                IsChecked="{Binding UseUppercase}" />
                            <CheckBox
                                Content="小写字母 (a-z)"
                                IsChecked="{Binding UseLowercase}" />
                            <CheckBox
                                Content="数字 (0-9)"
                                IsChecked="{Binding UseNumbers}" />
                            <CheckBox
                                Content="特殊符号 (!@#$)"
                                IsChecked="{Binding UseSymbols}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  按钮组（共享样式：与其他工具按钮统一高度/配色）  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Classes="action-button"
                            Command="{Binding GenerateCommand}"
                            Content="生成密码" />
                        <Button
                            Classes="secondary-button"
                            Command="{Binding CopyCommand}"
                            Content="复制密码" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
